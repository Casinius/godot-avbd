; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="AVBD Demo"
run/main_scene="res://scenes/stack.tscn"
config/features=PackedStringArray("4.7")

[physics]

3d/run_on_separate_thread=true
; 240 Hz is the sampling/interpolation rate. The solver advances on its own
; internal tick (avbd/internal_ticks_per_second) and this rate only samples it.
common/physics_ticks_per_second=240
3d/physics_engine="AVBD"
3d/solver/solver_iterations=4
common/physics_interpolation=true
avbd/beta_linear=100000.0
avbd/beta_angular=10.0
avbd/threads=8
avbd/internal_ticks_per_second=120
avbd/interleaved_substeps=true
avbd/rounds_per_substep=2
avbd/substeps=1
avbd/adaptive_max_iterations=12
#avbd/adaptive_beta=true
avbd/contact_grace_ticks=0
avbd/speculative_margin=0.02

[rendering]

renderer/rendering_method="mobile"
