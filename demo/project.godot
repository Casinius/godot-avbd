; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="AVBD Demo"
run/main_scene="res://scenes/stack.tscn"
config/features=PackedStringArray("4.7")

[physics]

3d/run_on_separate_thread=true
common/physics_ticks_per_second=240
3d/physics_engine="AVBD"
3d/solver/solver_iterations=4
common/physics_interpolation=true
avbd/beta_linear=100000.0
avbd/beta_angular=100.0
avbd/threads=8
avbd/interleaved_substeps=true
avbd/speculative_margin=0.02
avbd/iterations=12
avbd/max_internal_steps=12
avbd/rounds_per_substep=2
avbd/substeps=4
avbd/jacobian_rebuild_distance=0.02
avbd/position_projection=false
avbd/projection_iterations=1
avbd/projection_beta=0.5
avbd/projection_max_correction=0.1
avbd/internal_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
